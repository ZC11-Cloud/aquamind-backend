# Ignore Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore IDE-specific files and directories
.idea/
.vscode/

# Ignore environment variables and configuration files
.env
settings/__init__.py

# Ignore Alembic migration versions
alembic/versions/*.pyc
alembic/versions/__pycache__/

# YOLOv8 权重文件（体积大，不提交到 Git）
weights/*.pt

# Ignore test files and other temporary files
*.log
*.lock
*.egg-info
dist/
build/
*.http
data/chroma_kb/*.sqlite3
data/chroma_kb/*

# 用户上传的知识库文件（运行时生成，不提交）
uploads/
data/chroma_kb/chroma.sqlite3